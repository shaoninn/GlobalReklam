# Global Reklam Environment

# --- Hostinger MySQL (önerilen: ayrı alanlar, şifrede !? sorun olmaz) ---
# Hostinger panelinde NODE_ENV mutlaka production olmalı (development yazma)
NODE_ENV="production"
JWT_SECRET="change-me-to-a-long-random-secret-min-32-chars"
NEXT_PUBLIC_SITE_URL="https://globalreklam.com"
MYSQL_USER="your_mysql_user"
MYSQL_PASSWORD="your_mysql_password"
MYSQL_HOST="srvXXXX.hstgr.io"
MYSQL_PORT="3306"
MYSQL_DATABASE="your_database_name"
# 3–5 önerilir (layout+sayfa paralel). Acil durumda 1 + MYSQL_SERIALIZE=1
MYSQL_POOL_SIZE="3"
# Hostname: hPanel → Uzak MySQL (örn. srv1805.hstgr.io) — localhost kullanma

# Seed / bootstrap (canlıda bir kez)
# ADMIN_EMAIL="admin@globalreklam.com"
# ADMIN_PASSWORD="GucluSifre123"
# BOOTSTRAP_SECRET="rastgele-kurulum-anahtari"
# ALLOW_PROD_SEED="true"
